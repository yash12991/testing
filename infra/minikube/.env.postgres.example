# .env.postgres.example - template for infra/minikube/.env.postgres
#
# Copy this file to infra/minikube/.env.postgres (gitignored, never commit
# it) and fill in a real generated password before running
# deploy_postgres.sh. deploy_postgres.sh sources infra/minikube/.env.postgres
# to get POSTGRES_PASSWORD at deploy time; it is passed to Helm via
# --set auth.password=... rather than being written into the committed
# postgres-values.yaml file.
#
# Generate a password with e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
POSTGRES_USER=incident_app
POSTGRES_PASSWORD=changeme-generate-a-real-password
